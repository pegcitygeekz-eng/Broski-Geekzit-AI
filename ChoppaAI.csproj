<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Broski</AssemblyName>
    <AssemblyTitle>Broski AI</AssemblyTitle>
    <Product>Broski AI Desktop Companion</Product>
    <Version>0.0.3</Version>
    <AssemblyVersion>0.0.3.0</AssemblyVersion>
    <FileVersion>0.0.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref"
                        RuntimeFrameworkVersion="10.0.26100.86"
                        TargetingPackVersion="10.0.26100.86" />
    <Compile Remove="installer\SetupBootstrapper\**\*.cs" />
    <Compile Remove="installer\Uninstaller\**\*.cs" />
    <Compile Remove="Launcher\**\*.cs" />
    <Compile Remove="ChoppaAI.Android\**\*.cs" />
    <Content Include="animations\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="AIData\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
